# Enter secrets in Render's Environment page. This file is not loaded automatically.
APP_ENV=production
DEMO_MODE=false
AUTO_MIGRATE=false
# Render Blueprint supplies the database's INTERNAL URL automatically.
DATABASE_URL=
DATABASE_SSLMODE=require
GYM_TIMEZONE=Asia/Nicosia
# Leave unset on Render to use its generated URL. Set after connecting a custom domain.
PUBLIC_BASE_URL=
SECRET_KEY=
OWNER_EMAIL=
OWNER_NAME=
# First boot only; remove after creating the owner.
OWNER_PASSWORD=

# Email invitations: Resend, with an authorized sender on a verified domain.
RESEND_API_KEY=
INVITE_FROM_EMAIL=FORM <members@your-domain.example>

# Same provider as the Barbershop project, with a sender authorized for this gym.
SMS_PROVIDER=websms
WEBSMS_API_KEY=
WEBSMS_SENDER=

# Local development: APP_ENV=development, DEMO_MODE=true, AUTO_MIGRATE=true;
# leave DATABASE_URL unset and optionally set DATABASE_PATH=data/gym.sqlite3.
